[vllm]
load = "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8"
serve = "nvidia/nemotron-3-nano-30b-a3b-fp8-kv-fp8"

params = """
--max-model-len 24K
--max-num-batched-tokens 12K
--max-num-seqs 16
--kv-cache-dtype fp8
--enable-chunked-prefill
--gpu-memory-utilization 0.92
--moe-backend triton
--trust-remote-code
--reasoning-parser nemotron_v3
"""

[env]
FORWARDED_ALLOW_IPS = "*"

[boot]
image = "queuine/vellmi-pod:latest"

[gpu]
label = "NVIDIA RTX 6000 Ada Generation"
count = 1

[storage]
system = 20
models = 40

